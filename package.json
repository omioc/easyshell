{
  "name": "easyshell",
  "version": "0.1.3",
  "description": "Minimal cross-platform terminal: local shells, WSL, SSH, bastion friendly, agent ready.",
  "main": "./out/main/index.js",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/omioc/easyshell",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "brand:assets": "node scripts/brand-assets.cjs",
    "check:data": "node scripts/check-demo-data.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node tests/e2e/smoke.mjs",
    "e2e:deep": "node tests/e2e/deep.mjs",
    "e2e:ssh": "node tests/e2e/ssh.mjs",
    "e2e:scrollbar": "node tests/e2e/scrollbar.mjs",
    "e2e:packaged": "node tests/e2e/packaged.mjs",
    "verify:packaged": "npm run dist:win:fast && node tests/e2e/packaged.mjs",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:win:fast": "npm run build && electron-builder --win --x64 --dir",
    "dist:win:one": "npm run build && electron-builder --win nsis --x64",
    "dist:win:zip": "npm run build && electron-builder --win zip --x64",
    "dist:win:portable": "npm run build && electron-builder --win portable --x64",
    "dist:win:release": "npm run build && electron-builder --win --x64 --config.compression=maximum",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.18",
    "resedit": "^3.1.0",
    "ssh2": "^1.17.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ssh2": "^1.15.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.4.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-unicode11": "^0.8.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^6.0.0",
    "playwright": "^1.65.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.1.0"
  }
}
